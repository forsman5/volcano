value = 2.0

[node name="EnemyRow" type="HBoxContainer" parent="ConfigOverlay/PanelCenter/Panel/Content"]

[node name="EnemyLabel" type="Label" parent="ConfigOverlay/PanelCenter/Panel/Content/EnemyRow"]
