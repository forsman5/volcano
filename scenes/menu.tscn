horizontal_alignment = 1
theme_override_font_sizes/font_size = 32

[node name="AllyRow" type="HBoxContainer" parent="ConfigOverlay/PanelCenter/Panel/Content"]

[node name="AllyLabel" type="Label" parent="ConfigOverlay/PanelCenter/Panel/Content/AllyRow"]
