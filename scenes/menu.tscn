[gd_scene format=3 uid="uid://menu_scene"]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu_gd"]

[node name="Menu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu_gd")

[node name="CenterContainer" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="CenterContainer/VBoxContainer"]
text = "VOLCANO"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 72

[node name="StartButton" type="Button" parent="CenterContainer/VBoxContainer"]
text = "Start Game"
theme_override_font_sizes/font_size = 24

[node name="CustomButton" type="Button" parent="CenterContainer/VBoxContainer"]
text = "Start Game (Custom)"
theme_override_font_sizes/font_size = 24

[node name="ConfigOverlay" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
visible = false

[node name="DimBg" type="ColorRect" parent="ConfigOverlay"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.92)

[node name="PanelCenter" type="CenterContainer" parent="ConfigOverlay"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="ConfigOverlay/PanelCenter"]
custom_minimum_size = Vector2(320, 0)

[node name="Content" type="VBoxContainer" parent="ConfigOverlay/PanelCenter/Panel"]
